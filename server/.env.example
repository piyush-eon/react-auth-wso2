# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.
#
# Same app registration as the frontend's .env.local — this server uses
# the client ID/secret to authenticate its own calls to WSO2's token
# introspection endpoint (verifying a user's access token), not to sign
# in as a user itself.

ASGARDEO_BASE_URL="https://api.asgardeo.io/t/your_org_name"
ASGARDEO_CLIENT_ID="your_client_id"
ASGARDEO_CLIENT_SECRET="your_client_secret"
