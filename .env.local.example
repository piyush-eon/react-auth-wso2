# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit it.
#
# Where to get these: WSO2 console (console.asgardeo.io) → Applications →
# your app (registered via the "Next.js" quick-start template — see
# README.md for why it has to be that template specifically) → Protocol tab.

NEXT_PUBLIC_ASGARDEO_BASE_URL="https://api.asgardeo.io/t/your_org_name"
NEXT_PUBLIC_ASGARDEO_CLIENT_ID="your_client_id"

# No NEXT_PUBLIC_ prefix, deliberately — Next.js only bundles NEXT_PUBLIC_
# vars into client-side JS. This one stays server-side only.
ASGARDEO_CLIENT_SECRET="your_client_secret"

# "roles" is required for the admin role-gating demo (/admin, RequireRole,
# AdminOnly, the backend's 200 path) — see the "Roles, groups, and
# protected routes" section of the companion notes article for the role
# setup this scope depends on. "internal_login" is required for the SCIM2
# profile API UserProfile uses — without it, the profile request is
# rejected and the panel silently falls back to ID-token values only,
# with nothing editable.
NEXT_PUBLIC_ASGARDEO_SCOPES="openid profile roles internal_login"
NEXT_PUBLIC_ASGARDEO_SIGN_IN_URL="/sign-in"

# Not in WSO2's docs. Signs a temporary session cookie used during sign-in
# specifically (sign-up doesn't need it, so this is easy to miss locally).
# In dev the SDK silently falls back to an insecure default and only warns;
# in production (e.g. Vercel) it throws instead. Generate with:
#   openssl rand -base64 32
ASGARDEO_SECRET="a-long-random-string"

# Optional. Prints the SDK's own warnings server-side (e.g. why an expected
# sign-in redirect got skipped) — useful when something silently doesn't
# behave as expected and the browser console alone doesn't explain why.
# ASGARDEO_LOG_LEVEL=warn
